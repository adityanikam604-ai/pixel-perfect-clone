# MedGuard Environment Configuration
# ----------------------------------------------------
# 1. Supabase Connection (Required for Supabase Sync)
# ----------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# Optional: Supabase backend configuration (if using service role)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-or-anon-key

# ----------------------------------------------------
# 2. MedGuard Backend API
# ----------------------------------------------------
VITE_API_URL=http://localhost:5000/api
PORT=5000
